# State-aware-UI-agent Environment Configuration
# Copy to .env and fill in YOUR values
# Lines starting with # are comments

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED: LLM Provider & API Keys (must set for your chosen provider)
# ──────────────────────────────────────────────────────────────────────────────
# Choose one: "ollama" | "openrouter" | "openai"
LLM_PROVIDER=openrouter

# OpenRouter (required if LLM_PROVIDER=openrouter)
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (required if LLM_PROVIDER=openai)
# Get API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Provider-Specific Settings (override if needed)
# ──────────────────────────────────────────────────────────────────────────────

# OpenRouter - optional custom base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter - optional app identification for analytics
# OPENROUTER_REFERER=https://github.com/yourusername/your-repo
# OPENROUTER_APP_TITLE=My UI Agent

# OpenAI - optional custom base URL for Azure OpenAI or compatible APIs
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/

# Ollama - optional custom host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Model Override (if you want a specific model different from provider default)
# ──────────────────────────────────────────────────────────────────────────────
# MODEL_NAME=qwen3.5:397b-cloud              # For ollama
# MODEL_NAME=qwen/qwen2.5-vl-72b-instruct    # For openrouter
# MODEL_NAME=gpt-4o                          # For openai

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Generation Parameters (rarely need to change)
# ──────────────────────────────────────────────────────────────────────────────
# MODEL_TEMPERATURE=0.1
# MODEL_NUM_CTX=32768
# MODEL_NUM_PREDICT=512
# MODEL_TOP_P=1.0
# MODEL_TOP_K=0