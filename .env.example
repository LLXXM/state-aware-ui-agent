# State-aware-UI-agent Environment Configuration
# Copy to .env and fill in your values
# Lines starting with # are comments

# ──────────────────────────────────────────────────────────────────────────────
# LLM Provider Selection
# ──────────────────────────────────────────────────────────────────────────────
# Choose one: "ollama" | "openrouter" | "openai"
LLM_PROVIDER=openrouter

# ──────────────────────────────────────────────────────────────────────────────
# Model Configuration (overrides provider defaults)
# ──────────────────────────────────────────────────────────────────────────────
# MODEL_NAME=qwen3.5:397b-cloud              # For ollama
# MODEL_NAME=qwen/qwen2.5-vl-72b-instruct    # For openrouter
# MODEL_NAME=gpt-4o                          # For openai

# Generation options (apply where supported by provider)
MODEL_TEMPERATURE=0.1
MODEL_NUM_CTX=32768
MODEL_NUM_PREDICT=512
MODEL_TOP_P=1.0
MODEL_TOP_K=0

# ──────────────────────────────────────────────────────────────────────────────
# OpenRouter Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: App identification for OpenRouter analytics
# OPENROUTER_REFERER=https://github.com/yourusername/your-repo
# OPENROUTER_APP_TITLE=My UI Agent

# ──────────────────────────────────────────────────────────────────────────────
# OpenAI Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Get API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom base URL for Azure OpenAI or compatible APIs
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/

# ──────────────────────────────────────────────────────────────────────────────
# Ollama Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Ollama server URL (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Ollama retry settings
OLLAMA_CHAT_MAX_RETRIES=3
OLLAMA_CHAT_RETRY_DELAY=2.0

# ──────────────────────────────────────────────────────────────────────────────
# Agent Behavior
# ──────────────────────────────────────────────────────────────────────────────
MAX_ITERATIONS=30
SAVE_SCREENSHOTS=true
SAVE_ACTION_OVERLAYS=true
VERIFY_MOUSE_TARGETS=true
ABORT_ON_MOUSE_VERIFICATION_FAILURE=false
SCREENSHOT_DIR=agent_screenshots
REPORT_DIR=Reports
LOG_LEVEL=INFO
DRY_RUN=true

# Safety limits (set to 0 to disable)
MAX_TASK_DURATION=600
MAX_REPEATED_ACTIONS=3
MAX_CONSECUTIVE_FAILURES=3

# Delays in seconds
ITERATION_DELAY=0.5
POST_ACTION_DELAY=1.0
DRAG_DURATION=1.5